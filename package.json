{
  "name": "eta",
  "version": "0.0.1",
  "description": "Lightweight, fast, and powerful embedded JS template engine",
  "keywords": [
    "handlebars",
    "ejs",
    "eta",
    "template engine",
    "embedded template engine",
    "layouts",
    "partials",
    "typescript types"
  ],
  "main": "index",
  "author": "Manu Claeys <unam31@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eta-dev/eta.git"
  },
  "bugs": {
    "url": "https://github.com/eta-dev/eta/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=17.0.0"
  },
  "scripts": {
    "postversion": "node ./jsr.release.js",
    "test": "jest",
    "build-own": "rimraf dist && tsc && cpx \"src/templates/**/*\" dist/templates",
    "startNodemon": "nodemon --ext ts,eta,js,json,css,html --watch src --watch package.json --exec \"tsc && cpx src/templates/**/* dist/templates && cpx src/public/**/* dist/public && node dist/server.js\""
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@size-limit/preset-small-lib": "^8.2.4",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.4.0",
    "@types/node": "^18.14.2",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "commitizen": "^4.3.0",
    "coveralls": "^3.1.1",
    "cpx2": "^8.0.0",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.35.0",
    "eslint-config-prettier": "^8.6.0",
    "husky": "^4.3.8",
    "jest": "^29.7.0",
    "lint-staged": "^13.1.2",
    "microbundle": "^0.15.1",
    "nodemon": "^3.1.9",
    "np": "^7.6.3",
    "prettier": "^2.8.4",
    "rimraf": "^4.1.2",
    "shelljs": "^0.8.5",
    "size-limit": "^8.2.4",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.1",
    "tsc-watch": "^6.2.0",
    "tslib": "^2.5.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "express": "^5.1.0",
    "glob": "^11.0.1"
  }
}
